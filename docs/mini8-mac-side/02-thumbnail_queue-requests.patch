+def fetch_blob(sha):
+    data = json.loads(get(API + '/git/blobs/' + sha))
+    raw = base64.b64decode(data['content'])
+    if blob_sha(raw) != sha:
+        raise ValueError('Pinned source blob mismatch: ' + sha)
+    return raw
